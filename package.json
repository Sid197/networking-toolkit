{
  "name": "personal-networking-toolkit-pwa",
  "version": "1.0.0",
  "private": true,
  "description": "Offline IPv4 subnet calculator and networking reference toolkit",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "build": "vite build && node scripts-copy-sw.mjs",
